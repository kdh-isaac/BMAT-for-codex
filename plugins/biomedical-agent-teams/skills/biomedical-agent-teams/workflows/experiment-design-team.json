{
  "workflow_id": "experiment-design-team.standard",
  "runtime": "codex",
  "alias": "experiment-design-team",
  "mode": "standard",
  "track": "experimental-design",
  "nodes": [
    {
      "id": "S0_context_lock",
      "agent": "protocol-context-locker",
      "outputs": [
        "runtime_capability_preflight",
        "workflow_run"
      ],
      "blocking": true,
      "phase": "context"
    },
    {
      "id": "S1_design",
      "agent": "experimental-design-planner",
      "requires": [
        "S0_context_lock"
      ],
      "outputs": [
        "experiment_design",
        "source_corpus",
        "source_verification",
        "stage_evaluation"
      ],
      "blocking": true,
      "phase": "specialist"
    },
    {
      "id": "S2_stats",
      "agent": "biostats-repro-auditor",
      "requires": [
        "S1_design"
      ],
      "outputs": [
        "results_integration"
      ],
      "blocking": true,
      "spawnable": true,
      "toml_template_path": "codex-agents/biostats-repro-auditor.toml",
      "independence_required": true,
      "phase": "review",
      "required_checks": [
        "statistics.units",
        "statistics.methods"
      ],
      "required_input_refs": [
        "experiment_design.json"
      ]
    },
    {
      "id": "S3_claim_lock",
      "agent": "central-claim-ledger-evidence-graph",
      "requires": [
        "S2_stats"
      ],
      "outputs": [
        "claim_ledger",
        "claim_support_matrix"
      ],
      "blocking": true,
      "phase": "specialist"
    },
    {
      "id": "W_write",
      "agent": "scientific-writer-citation-agent",
      "phase": "write",
      "requires": [
        "S3_claim_lock"
      ],
      "outputs": [
        "final_text"
      ],
      "blocking": true
    },
    {
      "id": "S4_post_write",
      "agent": "post-write-final-validator",
      "requires": [
        "W_write"
      ],
      "outputs": [
        "post_write_validation",
        "review_artifact_manifest"
      ],
      "blocking": true,
      "spawnable": true,
      "toml_template_path": "codex-agents/post-write-final-validator.toml",
      "independence_required": true,
      "phase": "post-write",
      "required_checks": [
        "final.coverage",
        "final.scope"
      ],
      "required_input_refs": [
        "claim_ledger.json",
        "final.md"
      ]
    }
  ],
  "release_gates": [
    "bmat_validate",
    "bmat_tool_ledger_check"
  ]
}
