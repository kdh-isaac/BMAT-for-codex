{
  "workflow_id": "omics-analysis-team.run",
  "runtime": "codex",
  "alias": "omics-analysis-team",
  "mode": "run",
  "track": "omics",
  "nodes": [
    {
      "id": "S0_context_lock",
      "agent": "protocol-context-locker",
      "outputs": [
        "runtime_capability_preflight",
        "workflow_run"
      ],
      "blocking": true,
      "phase": "context"
    },
    {
      "id": "S1_plan",
      "agent": "omics-data-curator",
      "requires": [
        "S0_context_lock"
      ],
      "outputs": [
        "source_corpus",
        "source_verification",
        "omics_run_manifest"
      ],
      "blocking": true,
      "phase": "specialist"
    },
    {
      "id": "S1_setup",
      "agent": "omics-data-curator",
      "phase": "setup",
      "requires": [
        "S1_plan"
      ],
      "outputs": [],
      "blocking": true
    },
    {
      "id": "S1_smoke",
      "agent": "omics-provenance-validator",
      "phase": "pre-execution",
      "requires": [
        "S1_setup"
      ],
      "outputs": [
        "omics_metadata_check"
      ],
      "blocking": true
    },
    {
      "id": "S2_execute",
      "agent": "life-science-lead-scientist",
      "requires": [
        "S1_smoke"
      ],
      "outputs": [
        "analysis_artifacts",
        "results_integration",
        "claim_ledger"
      ],
      "blocking": true,
      "phase": "execute"
    },
    {
      "id": "S3_validate",
      "agent": "biostats-repro-auditor",
      "requires": [
        "S2_execute"
      ],
      "outputs": [
        "stage_evaluation",
        "claim_support_matrix",
        "omics_metadata_check"
      ],
      "blocking": true,
      "spawnable": true,
      "toml_template_path": "codex-agents/biostats-repro-auditor.toml",
      "independence_required": true,
      "phase": "review",
      "required_checks": [
        "statistics.units",
        "statistics.methods"
      ],
      "required_input_refs": [
        "claim_ledger.json",
        "source_corpus.json"
      ]
    },
    {
      "id": "S4_code_review",
      "agent": "omics-code-reviewer",
      "requires": [
        "S3_validate"
      ],
      "outputs": [
        "reviewer_output",
        "review_artifact_manifest"
      ],
      "blocking": true,
      "spawnable": true,
      "toml_template_path": "codex-agents/omics-code-reviewer.toml",
      "independence_required": true,
      "phase": "review",
      "required_checks": [
        "omics.code",
        "omics.provenance"
      ],
      "required_input_refs": [
        "claim_ledger.json",
        "source_corpus.json"
      ]
    },
    {
      "id": "W_write",
      "agent": "omics-reporter",
      "phase": "write",
      "requires": [
        "S4_code_review"
      ],
      "outputs": [
        "final_text"
      ],
      "blocking": true
    },
    {
      "id": "S5_post_write",
      "agent": "post-write-final-validator",
      "requires": [
        "W_write"
      ],
      "outputs": [
        "post_write_validation"
      ],
      "blocking": true,
      "spawnable": true,
      "toml_template_path": "codex-agents/post-write-final-validator.toml",
      "independence_required": true,
      "phase": "post-write",
      "required_checks": [
        "final.coverage",
        "final.scope"
      ],
      "required_input_refs": [
        "claim_ledger.json",
        "final.md"
      ]
    }
  ],
  "release_gates": [
    "bmat_validate",
    "bmat_tool_ledger_check"
  ]
}
