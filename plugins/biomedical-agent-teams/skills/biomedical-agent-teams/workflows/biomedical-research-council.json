{
  "workflow_id": "biomedical-research-council.standard",
  "runtime": "codex",
  "alias": "biomedical-research-council",
  "mode": "standard",
  "track": "general-biomedical",
  "nodes": [
    {
      "id": "S0_context_lock",
      "agent": "protocol-context-locker",
      "outputs": [
        "runtime_capability_preflight",
        "workflow_run"
      ],
      "blocking": true,
      "phase": "context"
    },
    {
      "id": "S1_source_lock",
      "agent": "life-science-literature-curator",
      "requires": [
        "S0_context_lock"
      ],
      "outputs": [
        "source_corpus",
        "source_verification"
      ],
      "blocking": true,
      "phase": "specialist"
    },
    {
      "id": "S2_claim_graph",
      "agent": "central-claim-ledger-evidence-graph",
      "requires": [
        "S1_source_lock"
      ],
      "outputs": [
        "claim_ledger"
      ],
      "blocking": true,
      "phase": "specialist"
    },
    {
      "id": "S3_review",
      "agent": "claim-level-evidence-verifier",
      "requires": [
        "S2_claim_graph"
      ],
      "outputs": [
        "results_integration",
        "claim_support_matrix"
      ],
      "blocking": true,
      "spawnable": true,
      "toml_template_path": "codex-agents/claim-level-evidence-verifier.toml",
      "independence_required": true,
      "phase": "review",
      "required_checks": [
        "claims.support",
        "claims.scope"
      ],
      "required_input_refs": [
        "claim_ledger.json",
        "source_corpus.json"
      ]
    },
    {
      "id": "W_write",
      "agent": "scientific-writer-citation-agent",
      "phase": "write",
      "requires": [
        "S3_review"
      ],
      "outputs": [
        "final_text"
      ],
      "blocking": true
    },
    {
      "id": "S4_write_validate",
      "agent": "post-write-final-validator",
      "requires": [
        "W_write"
      ],
      "outputs": [
        "post_write_validation",
        "review_artifact_manifest"
      ],
      "blocking": true,
      "spawnable": true,
      "toml_template_path": "codex-agents/post-write-final-validator.toml",
      "independence_required": true,
      "phase": "post-write",
      "required_checks": [
        "final.coverage",
        "final.scope"
      ],
      "required_input_refs": [
        "claim_ledger.json",
        "final.md"
      ]
    }
  ],
  "release_gates": [
    "bmat_validate",
    "bmat_tool_ledger_check"
  ]
}
