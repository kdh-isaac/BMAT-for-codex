{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Biomedical Agent Teams Post Write Validation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "validation_id",
    "plugin_version",
    "workflow_run_id",
    "checked_at",
    "final_validator_verdict",
    "unsupported_final_claims",
    "citation_or_provenance_mismatches",
    "missing_uncertainty_or_limitations",
    "safety_ethics_privacy_issues",
    "failure_mode_checklist",
    "excluded_claim_handling",
    "minimal_required_corrections",
    "release_ready_claim_strength"
  ],
  "properties": {
    "reviewed_final_ref": {"const": "final.md"},
    "reviewed_final_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "reviewed_ledger_ref": {"const": "claim_ledger.json"},
    "reviewed_ledger_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "coverage_review_instance_id": {"type": "string", "minLength": 1},
    "wording_policy": {"enum": ["literal", "reviewed-paraphrase"]},
    "content_coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "block_id",
          "block_sha256",
          "classification",
          "claim_ids",
          "reason"
        ],
        "properties": {
          "block_id": {
            "type": "string",
            "pattern": "^B[0-9]{4,}$"
          },
          "block_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "classification": {
            "enum": [
              "claim",
              "heading",
              "formatting",
              "non-claim"
            ]
          },
          "claim_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "schema_version": { "const": "2.0" },
    "validation_id": { "type": "string", "minLength": 1 },
    "plugin_version": { "type": "string", "minLength": 1 },
    "workflow_run_id": { "type": "string", "minLength": 1 },
    "checked_at": { "type": "string", "format": "date-time" },
    "final_validator_verdict": {
      "type": "string",
      "enum": ["pass", "pass-with-revisions", "block"]
    },
    "unsupported_final_claims": {
      "type": "array",
      "items": { "type": "string" }
    },
    "citation_or_provenance_mismatches": {
      "type": "array",
      "items": { "type": "string" }
    },
    "missing_uncertainty_or_limitations": {
      "type": "array",
      "items": { "type": "string" }
    },
    "safety_ethics_privacy_issues": {
      "type": "array",
      "items": { "type": "string" }
    },
    "failure_mode_checklist": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["failure_mode", "status", "reason"],
        "properties": {
          "failure_mode": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["pass", "warn", "suspected", "not-applicable"]
          },
          "reason": { "type": "string" }
        }
      }
    },
    "excluded_claim_handling": { "type": "string" },
    "independent_review_status": { "type": "string" },
    "minimal_required_corrections": {
      "type": "array",
      "items": { "type": "string" }
    },
    "release_ready_claim_strength": { "type": "string" }
  }
}
